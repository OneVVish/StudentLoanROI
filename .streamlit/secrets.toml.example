# Copy this file to secrets.toml (same directory) and fill in your real
# Supabase project URL + anon/publishable key. secrets.toml is gitignored
# and must never be committed. For the deployed app, paste this same
# content into Streamlit Community Cloud's "Advanced settings -> Secrets"
# field instead.

[connections.supabase_connection]
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-key"
# A JWT for the read-only `reporter` role, minted with
# `python3 infra/mint_reporter_jwt.py` (migrations.sql, 2026-08-30). The anon
# key above can INSERT and nothing else; this one can SELECT and nothing
# else. It is what the admin dashboard, analyze_survey.py, analyze_traffic.py
# and infra/rank_charts.py read with. Leave it out and the dashboard says so.
SUPABASE_READ_KEY = "your-reporter-role-jwt"

# Gates the Admin Analytics dashboard: it renders only for visits carrying
# ?admin=<this value> in the URL. Pick a long random string, e.g.
# `openssl rand -hex 16`. Top-level, like the Scorecard key below. Leaving
# it out is safe -- the dashboard is then unreachable (fails closed), which
# is the right default for a deployment that doesn't need it.
admin_key = "pick-a-long-random-string"

# Optional -- a personal (free) College Scorecard API key from
# https://api.data.gov/signup/. Top-level, not nested under [connections...]
# like the Supabase ones above. Falls back to the public "DEMO_KEY" if this
# is left out entirely, so it's fine to skip for local dev.
COLLEGE_SCORECARD_API_KEY = "your-personal-api-data-gov-key"

# Optional, and not read by the app at all -- only by marketing/reel.py, which
# synthesises the voiceover for the Instagram reels. Top level, like the
# Scorecard key. Leave it out and that script still runs: its default voice is
# local Kokoro, and --tts say is the fallback beyond that. Nothing else in the
# repo notices. ELEVENLABS_API_KEY in the environment wins over this.
elevenlabs_api_key = "your-elevenlabs-key"

# Optional. Only needed for the daily traffic digest's --email flag
# (analyze_traffic.py / daily_digest.sh). Leave this block out entirely and the
# digest still runs -- it just writes to analysis_output/traffic_digest.log and
# posts a macOS notification instead.
#
# app_password is a GMAIL APP PASSWORD, not your account password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Gmail rejects a normal password over SMTP, so there is no way to use one here
# even by accident. This file is gitignored; keep it that way.
[email]
username = "you@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"
to = "you@gmail.com"
smtp_host = "smtp.gmail.com"
smtp_port = 587

# Optional. Only needed by analyze_reddit.py, the article-idea digest -- the app
# never reads it. Get the token from console.apify.com -> Settings -> API & Integrations.
#
# `actor` is which Reddit scraper to run, as `username~actor-name`. It is a
# setting rather than a constant because these actors break whenever Reddit
# changes its defenses; swapping one is meant to be a one-line change. Whichever
# you pick, run `python3 analyze_reddit.py --check-auth` afterwards -- it prints
# the field names the actor really returns, and ACTOR_FIELD_MAP is a guess about
# someone else's schema until it has.
#
# Billing is per result (roughly $2 per 1,000 on the cheap actors), so a monthly
# run over four subreddits costs a few dollars. Avoid the rental-model actors
# unless you are pulling far more than this.
[apify]
token = "apify_api_xxxxxxxxxxxxxxxxxxxx"
actor = "practicaltools~apify-reddit-api"

# Optional, and not usable yet. Reddit's June 2026 Responsible Builder Policy
# requires explicit approval before any Data API access, so this is for when
# that lands -- `analyze_reddit.py --source api` then replaces the Apify path
# with the sanctioned one. Register a "script" app at reddit.com/prefs/apps:
# client_id is the string under the app name, client_secret the one labelled
# "secret". `username` is NOT used to log in -- it goes in the User-Agent, which
# Reddit requires to identify the caller.
[reddit]
client_id = "xxxxxxxxxxxxxxxxxxxxxx"
client_secret = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
username = "your-reddit-username"

# Optional, and not read by the app -- only by brand/build_ai_hero.py, which
# generates the guide hero backgrounds through Cloudflare Workers AI. Top
# level. Leave both out and that script prints what it needs and stops; the
# committed heroes in static/ are what the site serves. CF_ACCOUNT_ID and
# CF_API_TOKEN in the environment win over these.
CF_ACCOUNT_ID = "your-cloudflare-account-id"
CF_API_TOKEN = "your-cloudflare-workers-ai-token"
