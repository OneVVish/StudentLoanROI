# Copy this file to secrets.toml (same directory) and fill in your real
# Supabase project URL + anon/publishable key. secrets.toml is gitignored
# and must never be committed. For the deployed app, paste this same
# content into Streamlit Community Cloud's "Advanced settings -> Secrets"
# field instead.

[connections.supabase_connection]
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-key"

# Optional -- a personal (free) College Scorecard API key from
# https://api.data.gov/signup/. Top-level, not nested under [connections...]
# like the Supabase ones above. Falls back to the public "DEMO_KEY" if this
# is left out entirely, so it's fine to skip for local dev.
COLLEGE_SCORECARD_API_KEY = "your-personal-api-data-gov-key"
