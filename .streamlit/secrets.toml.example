# Copy this file to secrets.toml (same directory) and fill in your real
# Supabase project URL + anon/publishable key. secrets.toml is gitignored
# and must never be committed. For the deployed app, paste this same
# [connections.supabase_connection] block into Streamlit Community Cloud's
# "Advanced settings -> Secrets" field instead.

[connections.supabase_connection]
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-key"
