# Secrets -- never commit real Supabase credentials
.streamlit/secrets.toml

# Legacy local CSV logs (superseded by Supabase; harmless to ignore either way)
usage_logs.csv
survey_responses.csv

# Python
__pycache__/
*.pyc
.venv/

# Generated by analyze_survey.py -- local research output, not source
analysis_output/

# Research paper draft -- kept local, not part of the app codebase
research_paper_draft.md

# Internal engineering field guide (lessons, constraints, past bugs) --
# deliberately kept out of the public repo, and purged from git history
# 2026-08-06 before the repo went public. Code comments still cite it by
# name; ARCHITECTURE.md is the public map, this is the private manual.
CLAUDE.md

# Slide deck for counselor/teacher outreach -- kept local, not part of the app codebase
presentation/

# Marketing/outreach working files (src taxonomy, email templates, launch copy,
# send logs) -- kept local for the same reason as presentation/
marketing/

# Everything feeding the research paper stays local, same as the draft above:
# scope/limitations notes, paper structure outlines, and any future drafts.
# Ignored rather than merely untracked -- this repo's commits are routinely
# staged with `git add -A`, which would sweep an untracked file in silently.
SCOPE.md
RETURNING_STUDENT_PLAN.md
*_PLAN.md
paper_outline.md
paper_*.md
*_draft.md
Most-Recent-Cohorts-Institution.csv
# 153 MB raw field-of-study release; build_professional_debt.py reads it and
# the cleaned output (data/graduate_debt_clean.csv) is what ships.
# Download the DATED filename -- the undated one serves an older release, see
# the note in build_professional_debt.py's docstring.
Most-Recent-Cohorts-Field-of-Study.csv
# Raw IPEDS releases for build_graduate_tuition.py; the cleaned output
# (data/graduate_tuition_clean.csv) is what ships. Both the zips as downloaded
# and the CSVs they unpack to.
IC[0-9][0-9][0-9][0-9]_AY.zip
ic[0-9][0-9][0-9][0-9]_ay.csv
HD[0-9][0-9][0-9][0-9].zip
HD[0-9][0-9][0-9][0-9].csv
fos*.zip
national_M2025_dl.xlsx
state_M2025_dl.xlsx
MSA_M2025_dl.xlsx
occupation.xlsx
# CPS ASEC person file for build_hs_age_profile.py -- ~280MB unzipped
pppub*.csv
